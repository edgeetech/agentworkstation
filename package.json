{
  "name": "agentworkstation",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:build-main": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm:electron:start\"",
    "electron:start": "npm run electron:build-main && electron .",
    "electron:pack": "npm run build && npm run electron:build-main",
    "test": "vitest run --environment node",
    "test:watch": "vitest --environment node",
    "lint": "eslint .",
    "check:architecture": "vitest run tests/architecture",
    "test:e2e": "playwright test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "electron": "^44.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.54.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.25.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}

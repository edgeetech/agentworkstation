{
  "name": "agentworkstation",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop workstation for evidence-backed career agents.",
  "author": "EDGEETECH",
  "type": "commonjs",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:build-main": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm:electron:start\"",
    "electron:start": "npm run electron:build-main && electron .",
    "electron:prepare": "npm run build && npm run electron:build-main",
    "electron:pack": "npm run electron:prepare && electron-builder --win nsis --publish never",
    "test": "vitest run --environment node",
    "test:watch": "vitest --environment node",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "check:architecture": "vitest run tests/architecture",
    "test:e2e": "npm run electron:prepare && playwright test",
    "e2e": "npm run electron:prepare && playwright test",
    "export:plugins": "tsx scripts/plugin-export/export-plugins.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^11.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@github/copilot-sdk": "^1.0.14",
    "@playwright/test": "^1.54.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/expect": "^5.0.0",
    "concurrently": "^9.0.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.edgeetech.agentworkstation",
    "productName": "Agent Workstation",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron-main.cjs",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*"
    ],
    "extraResources": [
      {
        "from": "src/agents",
        "to": "agents"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Agent-Workstation-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
